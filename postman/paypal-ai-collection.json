{
  "info": {
    "name": "AgentPay - PayPal AI API Test Suite",
    "_postman_id": "c71a39df-1558-45e0-9428-paypal-ai-2026",
    "description": "Comprehensive Postman test collection for AgentPay's PayPal Orders v2 integration, token issuance, and agentic settlement workflows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. PayPal OAuth2 Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Accept-Language", "value": "en_US" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "client_credentials", "type": "text" }
          ]
        },
        "url": {
          "raw": "https://api-m.sandbox.paypal.com/v1/oauth2/token",
          "protocol": "https",
          "host": ["api-m", "sandbox", "paypal", "com"],
          "path": ["v1", "oauth2", "token"]
        }
      }
    },
    {
      "name": "2. Create Order v2 (Agentic Intent)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"intent\": \"CAPTURE\",\n  \"purchase_units\": [\n    {\n      \"reference_id\": \"AGENTPAY-ORDER-991\",\n      \"amount\": {\n        \"currency_code\": \"USD\",\n        \"value\": \"849.00\"\n      },\n      \"description\": \"AgentPay Autonomous Purchase: Dell XPS 13 Developer Edition\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "https://api-m.sandbox.paypal.com/v2/checkout/orders",
          "protocol": "https",
          "host": ["api-m", "sandbox", "paypal", "com"],
          "path": ["v2", "checkout", "orders"]
        }
      }
    },
    {
      "name": "3. Capture Order v2",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "https://api-m.sandbox.paypal.com/v2/checkout/orders/{{order_id}}/capture",
          "protocol": "https",
          "host": ["api-m", "sandbox", "paypal", "com"],
          "path": ["v2", "checkout", "orders", "{{order_id}}", "capture"]
        }
      }
    },
    {
      "name": "4. AgentPay Local AI Analyze (Gemini + Rules)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Find me noise cancelling headphones under $250\",\n  \"budgetCap\": 250\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/ai/analyze",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "ai", "analyze"]
        }
      }
    },
    {
      "name": "5. AgentPay Local Create Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 849.00,\n  \"currency\": \"USD\",\n  \"description\": \"Dell XPS 13 Developer Edition\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/paypal/create-order",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "paypal", "create-order"]
        }
      }
    },
    {
      "name": "6. AgentPay Local Capture Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"ORDER-SAMPLE-ID\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/paypal/capture-order",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "paypal", "capture-order"]
        }
      }
    },
    {
      "name": "7. AgentPay Safe AI MCP Gateway",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"test_1\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"paypal_check_purchase_policy\",\n    \"arguments\": {\n      \"vendorName\": \"CloudTech Supply\",\n      \"quotedAmount\": 949.00,\n      \"budgetCap\": 900.00,\n      \"unapprovedMarkup\": 100.00\n    }\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/mcp",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "mcp"]
        }
      }
    },
    {
      "name": "8. AgentPay Zapier Webhook Alert",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"POLICY_OVERCHARGE_BLOCKED\",\n  \"payload\": {\n    \"vendor\": \"CloudTech Supply\",\n    \"quotedAmount\": 949.00,\n    \"budgetCap\": 900.00,\n    \"blockedMarkup\": 100.00\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/zapier/webhook",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "zapier", "webhook"]
        }
      }
    },
    {
      "name": "9. AgentPay Health & Neon Telemetry",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "10. AgentPay Neon + LocalStorage Ledger Read",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/ledger?workspaceId=default",
